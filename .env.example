# Database Configuration
DATABASE_URL=sqlite:///./academic_recommender.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/academic_db

# API Configuration
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# ML Configuration
ML_N_FACTORS=10
ML_MIN_INTERACTIONS=5

# Graph Configuration
GRAPH_ENABLE_REASONING=true
GRAPH_CACHE_ENABLED=true

# Logging
LOG_LEVEL=INFO
