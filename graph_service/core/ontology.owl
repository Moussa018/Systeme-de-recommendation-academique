<?xml version="1.0"?>
<rdf:RDF xmlns="http://ensias.ma/academic#"
     xml:base="http://ensias.ma/academic"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://ensias.ma/academic"/>

    <owl:Class rdf:about="http://ensias.ma/academic#Student"/>
    <owl:Class rdf:about="http://ensias.ma/academic#Module"/>
    <owl:Class rdf:about="http://ensias.ma/academic#Competence"/>

    <owl:ObjectProperty rdf:about="http://ensias.ma/academic#hasPrerequisite">
        <rdfs:domain rdf:resource="http://ensias.ma/academic#Module"/>
        <rdfs:range rdf:resource="http://ensias.ma/academic#Module"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://ensias.ma/academic#mastersCompetence">
        <rdfs:domain rdf:resource="http://ensias.ma/academic#Student"/>
        <rdfs:range rdf:resource="http://ensias.ma/academic#Competence"/>
    </owl:ObjectProperty>
</rdf:RDF>